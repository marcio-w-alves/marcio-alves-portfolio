{
  "name": "marcio-alves-portfolio",
  "version": "0.0.0-semantically-released",
  "description": "Personal portfolio with a grounded AI assistant.",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "boundaries": "depcruise src",
    "boundaries:graph": "depcruise src --output-type dot",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm boundaries && pnpm test",
    "prepare": "lefthook install",
    "release": "semantic-release",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "rag:build": "tsx --env-file=.env.local scripts/build-knowledge-index.mts",
    "eval:assistant": "tsx --env-file=.env.local scripts/evaluate-assistant.mts",
    "fidelity": "tsx scripts/fidelity/check.mts",
    "fidelity:references": "tsx scripts/fidelity/capture-references.mts",
    "fidelity:live": "tsx scripts/fidelity/check.mts --live"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "next": "16.4.3",
    "openai": "7.45.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "1.64.1",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.3",
    "lefthook": "2.2.2",
    "msw": "3.0.3",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "semantic-release": "25.0.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "undici": "8.12.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
