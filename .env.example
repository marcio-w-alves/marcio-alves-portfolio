# Model credentials. Server-side only: never expose with the NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=sk-...

# Raises the GitHub API rate limit for the repository tools. Optional.
GITHUB_TOKEN=

# Canonical origin, used for metadata, sitemap and canonical links. Optional:
# on Vercel it defaults to the production domain (https://marciomariani.dev once
# assigned), and locally to http://localhost:3000.
SITE_URL=
