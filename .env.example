# Model credentials. Server-side only: never expose with the NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=sk-...

# Raises the GitHub API rate limit for the repository tools. Optional.
GITHUB_TOKEN=

# Canonical origin, used for metadata, sitemap and canonical links. Optional:
# on Vercel it defaults to the production domain (https://marciomariani.dev once
# assigned), and locally to http://localhost:3000.
SITE_URL=

# Release tag reported by /api/health. Optional: Vercel cannot know it at build
# time, so it is null unless a deployment sets it.
RELEASE_VERSION=

# Operational settings. All optional; the defaults are what production runs.
# The chat model that answers what the fast path cannot. Default gpt-4o-mini.
OPENAI_CHAT_MODEL=
# How long an OpenAI call may wait for a response, or go quiet mid-stream. Default 20000.
OPENAI_TIMEOUT_MS=
# Requests one visitor may send in any ten minutes, fast path included. Default 40.
CHAT_REQUESTS_PER_TEN_MINUTES=
# Model answers one visitor may start in any ten minutes. Default 15.
MODEL_ANSWERS_PER_TEN_MINUTES=
# Model tokens one server instance may spend per UTC day. Default 2000000.
MODEL_DAILY_TOKENS=

# Model that grades answers in `pnpm eval:assistant`. Default gpt-4o-mini, like
# the assistant; a larger judge multiplies the cost of every evaluation run.
EVAL_JUDGE_MODEL=
